<Window x:Class="CP2077SaveEditor.Wpf.Views.SaveChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save changes" Width="560" Height="680" ResizeMode="NoResize" ShowInTaskbar="False"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <!-- Large selectable option -->
        <Style x:Key="OptionCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,12">
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,12,0" VerticalAlignment="Top">
                                    <Ellipse Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.5" />
                                    <Ellipse x:Name="Dot" Margin="4" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextDimBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="SAVE CHANGES" Style="{StaticResource H1}" FontSize="22" MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True" Margin="0,14,0,0">
                <StackPanel>
                    <!-- What changed -->
                    <TextBlock Text="{Binding ChangesSummary}" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Changes}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="6" Height="6" Fill="{StaticResource CyanBrush}" Margin="2,5,10,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{StaticResource CyanBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Where to write -->
                    <TextBlock Text="WHERE TO SAVE" Style="{StaticResource Label}" Margin="0,16,0,8" />
                    <RadioButton Style="{StaticResource OptionCard}" IsChecked="{Binding SaveAsNewSlot}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NewSlotName, StringFormat=New slot  ·  {0}}" Style="{StaticResource H2}" />
                                <Border Background="{StaticResource AccentBrush}" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="RECOMMENDED" Foreground="{StaticResource BgBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Your original save stays untouched. The new save appears in the game's load menu."
                                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource OptionCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentSlotName, StringFormat=Overwrite  ·  {0}}" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0">
                                <Run Text="A backup of the current files is stored in" />
                                <Run Text="{Binding BackupRoot, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions stay visible while the dialog body scrolls. -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="Preparing…" Style="{StaticResource Dim}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" IsCancel="True" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Content="SAVE" Style="{StaticResource PrimaryButton}" IsDefault="True"
                            IsEnabled="{Binding CanWrite}" Click="Save_Click" MinWidth="110" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
