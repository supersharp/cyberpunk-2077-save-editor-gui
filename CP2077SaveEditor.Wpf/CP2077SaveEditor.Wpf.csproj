<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CP2077SaveEditor.Wpf</RootNamespace>
    <AssemblyName>CP2077SaveEditor.Wpf</AssemblyName>
    <ApplicationIcon>..\CP2077SaveEditor\icon.ico</ApplicationIcon>
    <Version>1.1.2</Version>
  </PropertyGroup>

  <!-- Release: dotnet publish -c Release -r win-x64 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- DirectXTexNet locates its native DLL next to its own assembly file, which has no path inside a single-file
       bundle. The three DLLs are embedded instead and unpacked on first use (Services/NativeLibraries.cs), so the
       release is one exe. Kraken builds for macOS/Linux are not needed on Windows. -->
  <ItemGroup>
    <EmbeddedResource Include="..\WolvenKit\WolvenKit.Common\lib\DirectXTexNet.dll" LogicalName="native/DirectXTexNet.dll" Visible="false" />
    <EmbeddedResource Include="..\WolvenKit\WolvenKit.Common\lib\DirectXTexNetImpl.dll" LogicalName="native/lib/DirectXTexNetImpl.dll" Visible="false" />
    <EmbeddedResource Include="..\WolvenKit\WolvenKit.Common\lib\Ijwhost.dll" LogicalName="native/lib/Ijwhost.dll" Visible="false" />
  </ItemGroup>
  <Target Name="AdjustPublishedFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('DirectXTexNet')) Or '%(Filename)' == 'Ijwhost' Or '%(RelativePath)' == 'lib\COPYING'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'libkraken' Or '%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CP2077SaveEditor.Core\CP2077SaveEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\CP2077SaveEditor\icon.ico" Link="Assets\icon.ico" />
    <Resource Include="..\CP2077SaveEditor\Resources\corpo.png" Link="Assets\lifepath_corpo.png" />
    <Resource Include="..\CP2077SaveEditor\Resources\nomad.png" Link="Assets\lifepath_nomad.png" />
    <Resource Include="..\CP2077SaveEditor\Resources\streetkid.png" Link="Assets\lifepath_streetkid.png" />
  </ItemGroup>

</Project>
